# Kopieer naar .env in de root van de repo (staat in .gitignore) of zet als GitHub Secrets.

# Supabase-project: Settings > API. Gebruik de service_role key (server-side; nooit in een app zetten).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=

# Contactadres dat in de User-Agent meegaat, zodat de sitebeheerder je kan bereiken (e-mail of URL).
SYNC_CONTACT=

# Optioneel
#EIGEN_PLOEG=Steca Juniors
#KAVVV_BASE_URL=https://www.kavvv-vb-ov.be/
#KAVVV_KLASSEMENT_ID=7
#KAVVV_UITSLAGEN_ID=6
#KAVVV_KALENDER_ID=5
#SYNC_REQUEST_DELAY=0.5
